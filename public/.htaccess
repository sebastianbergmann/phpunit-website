SetEnvIf Request_URI "^/manual/" LEGACY_MANUAL

Header always unset X-Powered-By
Header always unset Server

Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'" env=!LEGACY_MANUAL
Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self';" env=LEGACY_MANUAL

# Keep the archived manuals out of the index. They stay crawlable on purpose:
# a Disallow in robots.txt would stop crawlers from ever seeing this header.
Header always set X-Robots-Tag "noindex, follow" env=LEGACY_MANUAL

RewriteEngine On

# Only the tutorial for the current major version is maintained, and it now
# lives at a stable, version-free URL instead of in a directory of one.
RewriteRule ^getting-started/phpunit-13\.html$ /getting-started.html [R=301,L]
RewriteRule ^getting-started/?$               /getting-started.html [R=301,L]

# The retired tutorials point at the documentation for their own version: the
# archived manual for PHPUnit 4-6, docs.phpunit.de for 7-12. These come first,
# and each carries [L], so the index.html rule below cannot rewrite them.
RewriteRule ^getting-started/phpunit-4\.html$  /manual/4.8/en/ [R=301,L]
RewriteRule ^getting-started/phpunit-5\.html$  /manual/5.7/en/ [R=301,L]
RewriteRule ^getting-started/phpunit-6\.html$  /manual/6.5/en/ [R=301,L]
RewriteRule ^getting-started/phpunit-7\.html$  https://docs.phpunit.de/en/7.5/ [R=301,L]
RewriteRule ^getting-started/phpunit-8\.html$  https://docs.phpunit.de/en/8.5/ [R=301,L]
RewriteRule ^getting-started/phpunit-9\.html$  https://docs.phpunit.de/en/9.6/ [R=301,L]
RewriteRule ^getting-started/phpunit-10\.html$ https://docs.phpunit.de/en/10.5/ [R=301,L]
RewriteRule ^getting-started/phpunit-11\.html$ https://docs.phpunit.de/en/11.5/ [R=301,L]
RewriteRule ^getting-started/phpunit-12\.html$ https://docs.phpunit.de/en/12.5/ [R=301,L]

# /index.html -> /, /announcements/index.html -> /announcements/, and so on.
# Matching THE_REQUEST means the internal DirectoryIndex lookup for "/" does
# not re-enter this rule, so there is no redirect loop.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

RedirectPermanent /professional-services.html https://phpunit.expert/?ref=phpunit.de
RedirectPermanent /newsletter https://t8cbf4509.emailsys1a.net/275/973/33ad04f4be/subscribe/form.html?_g=1752156344
RedirectPermanent /test-smarter-not-harder.html https://thephpcc.academy/en/test-smarter-not-harder?ref=phpunit#dates
